<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>KLU8GF65GP.com.alick.sdp-proxy.tunnel</string>
	<key>com.apple.developer.team-identifier</key>
	<string>KLU8GF65GP</string>
	<!-- app extension 必须是沙箱化的：不开 App Sandbox 时 pkd 会直接拒绝注册
	     （日志："Ignoring mis-configured plugin ...: plug-ins must be sandboxed"），
	     pluginkit 里看不到它，NE 也就永远找不到 provider。
	     这是与 SystemExtension 的关键差别——后者不需要沙箱。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- 沙箱下必须显式声明网络权限，否则 bind 会被拒：
	     "bind(127.0.0.1:11097) failed [1: Operation not permitted]"。
	     server = 监听本地端口（hev 的 SOCKS 出口 / Tailscale 本地接口）
	     client = 主动外连（SDP 网关、WG endpoint、TS DERP） -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- app extension 形态的 packet tunnel provider 必须有这个 entitlement，
	     否则 NE 子系统不会实例化 provider（系统会报 "provider is not entitled"）。
	     注意：app extension 用不带 -systemextension 后缀的值。 -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>KLU8GF65GP.com.alick.sdp-proxy</string>
	</array>
</dict>
</plist>

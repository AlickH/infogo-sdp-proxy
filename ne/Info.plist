<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>SDPNE</string>
	<key>CFBundleIdentifier</key>
	<string>com.alick.sdp-proxy.tunnel</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SDP Proxy NE</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<!-- app extension 的版本必须与宿主 App 完全一致（Xcode 会校验，
	     不一致时 embeddedBinaryValidationUtility 报 warning 且 NE 可能拒绝加载）。
	     两处都用同一组构建设置，避免以后改版本时漂移。 -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- app extension 的标准入口：系统按 principal class 实例化，
	     不需要 sysextd 激活，也不会出现在「登录项与扩展」里 -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.networkextension.packet-tunnel</string>
		<key>NSExtensionPrincipalClass</key>
		<string>SDPNE.MergedProvider</string>
	</dict>
</dict>
</plist>
